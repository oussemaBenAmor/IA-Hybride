<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>virement_international_eleve</name>
  <uuid>4e71aff0-5a00-4c96-a494-e2bfab908fd0</uuid>
  <locale>fr_FR</locale>
  <definition><![CDATA[si le type virement de requestVirement est "international" et le montant de requestVirement est plus grand que 10000
alors assigner le decision de responseVirement à "VERIFICATION_REQUISE";
ajouter "regle_virement_international_controle" aux règles déclenchées de responseVirement ; ]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
