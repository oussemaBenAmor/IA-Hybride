<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>motif_taux_endettement</name>
  <uuid>52390da0-69f0-46c7-84dc-b6915cf48a28</uuid>
  <locale>fr_FR</locale>
  <definition><![CDATA[si le taux endettement de response est plus grand que 35
alors assigner le decision de response à "REFUSE" ;
     ajouter "TAUX_ENDETTEMENT_DEPASSE" aux règles déclenchées de response ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
