<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>assurance_age_depasse</name>
  <uuid>5677693f-029e-467b-846d-ff5e65b09ff9</uuid>
  <locale>fr_FR</locale>
  <definition><![CDATA[si l'age de requestAssurance est plus grand que 85
alors assigner le decision de responseAssurance à "REFUSE";
 ajouter "regle_age_souscription_depasse" aux règles déclenchées de responseAssurance ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>
